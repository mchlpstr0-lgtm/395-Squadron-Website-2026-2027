---
permalink: /manifest.webmanifest
eleventyExcludeFromCollections: true
---
{
  "name": {{ site.name | json | safe }},
  "short_name": "395 Squadron",
  "start_url": "{{ env.base }}/",
  "scope": "{{ env.base }}/",
  "display": "standalone",
  "background_color": "#0d1a3a",
  "theme_color": "#12234a",
  "icons": [
    { "src": "{{ env.base }}/assets/img/brand/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "{{ env.base }}/assets/img/brand/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ]
}
